##keybindings
#disable ctrl+shift+f (nvim)
keybind = ctrl+shift+f=unbind

#disable alt+left, alt+right keybindings
macos-option-as-alt = left
keybind = alt+left=unbind
keybind = alt+right=unbind

#style
background-opacity = 0.9
background-blur-radius = 20
background = #031219


copy-on-select                 = true
shell-integration              = zsh
clipboard-trim-trailing-spaces = true

window-padding-balance = true
window-padding-y = 0
window-padding-color = extend

# ==========================================
# Panels (SPLITS)
# ==========================================
# new panel  (Horizontal / Vertical)
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down


# navigate
keybind = super+alt+l=goto_split:left
keybind = super+alt+h=goto_split:right
keybind = super+alt+k=goto_split:up
keybind = super+alt+j=goto_split:down

# Maximizar / Minimizar el panel actual dentro de la ventana
keybind = super+shift+enter=toggle_split_zoom

